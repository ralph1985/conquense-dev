---
import { languageNames, type AlternateLink, type Language } from '@/data/i18n';
import type { PortfolioSection } from '@/data/sections';

interface Props {
  sections: PortfolioSection[];
  lang: Language;
  alternateLink: AlternateLink;
  labels: {
    navLabel: string;
    skipLink: string;
    languageLabel: string;
    goToSectionLabel: string;
    themeToggleLabel: string;
    themeSystemLabel: string;
    themeLightLabel: string;
    themeDarkLabel: string;
  };
}

const { sections, lang, alternateLink, labels } = Astro.props;
---

<nav class="progress-nav" aria-label={labels.navLabel} data-progress-nav>
  <a class="skip-link" href="#contenido">{labels.skipLink}</a>
  <div class="progress-nav__meta" aria-live="polite">
    <span class="progress-nav__count">
      <span data-current-index>01</span>
      <span aria-hidden="true">/</span>
      <span>{String(sections.length).padStart(2, '0')}</span>
    </span>
    <span class="progress-nav__name" data-current-name>{sections[0]?.title}</span>
    <span class="progress-nav__controls">
      <button
        class="progress-nav__theme"
        type="button"
        aria-label={labels.themeToggleLabel}
        title={labels.themeToggleLabel}
        data-theme-toggle
        data-label-toggle={labels.themeToggleLabel}
        data-label-system={labels.themeSystemLabel}
        data-label-light={labels.themeLightLabel}
        data-label-dark={labels.themeDarkLabel}
      >
        <span data-theme-state>{labels.themeSystemLabel}</span>
      </button>
      <a class="progress-nav__language" href={alternateLink.href} aria-label={`${labels.languageLabel}: ${languageNames[alternateLink.lang]}`}>
        <span>{languageNames[lang]}</span>
        <span aria-hidden="true">/</span>
        <span>{languageNames[alternateLink.lang]}</span>
      </a>
    </span>
  </div>
  <div class="progress-nav__bar" aria-hidden="true">
    <span data-progress-bar></span>
  </div>
  <ol class="progress-nav__dots">
    {
      sections.map((section, index) => (
        <li>
          <a
            href={`#${section.slug}`}
            class="progress-nav__dot"
            aria-label={`${labels.goToSectionLabel} ${section.title}`}
            aria-current={index === 0 ? 'step' : undefined}
            data-section-link
            data-section-index={index}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
