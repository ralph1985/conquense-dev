---
import BrandLogo from '@/components/BrandLogo.astro';
import { siteConfig } from '@/config/site';
import { languageNames, routesByLanguage, type AlternateLink, type Language } from '@/data/i18n';
import { localizedExperience } from '@/data/experience';
import { localizedProjects } from '@/data/projects';
import { localizedPortfolioSections, type PortfolioSection } from '@/data/sections';

interface Props {
  lang: Language;
  alternateLink: AlternateLink;
  labels: {
    navLabel: string;
    skipLink: string;
    languageLabel: string;
    themeToggleLabel: string;
    themeSystemLabel: string;
    themeLightLabel: string;
    themeDarkLabel: string;
  };
}

const { lang, alternateLink, labels } = Astro.props;
const sections = localizedPortfolioSections[lang];
const routeSet = routesByLanguage[lang];
const experience = localizedExperience[lang];
const projects = localizedProjects[lang];

const byId = (id: PortfolioSection['id']) => sections.find((section) => section.id === id);

const intro = byId('home') ?? sections[0];
const profile = byId('profile');
const workflow = byId('workflow');
const architecture = byId('architecture');
const stack = byId('stack');
const contact = byId('contact');
const featuredExperience = experience.items.slice(0, 3);
const featuredProjects = projects.items.slice(0, 3);
const currentLanguage = languageNames[lang];
const alternateLanguage = languageNames[alternateLink.lang];
const contactSlug = lang === 'es' ? 'contacto' : 'contact';
const brandMarks = [
  { name: 'BBVA', logo: '/assets/logos/bbva.svg' },
  { name: 'Vueling', logo: '/assets/logos/vueling.svg' },
  { name: 'Iberostar', logo: '/assets/logos/iberostar.jpg' },
  { name: 'National Express', logo: '/assets/logos/national-express.svg' },
  { name: 'Carrefour', logo: '/assets/logos/carrefour.svg' },
  { name: 'Alsa', logo: '/assets/logos/alsa.svg' },
];
const brandInitials: Record<string, string> = {
  BBVA: 'BBVA',
  'Mobile One2One': 'MO2O',
  'Geanet onDemand': 'GE',
  'Transport, hotels and retail': 'THR',
  'Transporte, hoteles y retail': 'THR',
};
const experienceLogos: Record<string, string> = {
  BBVA: '/assets/logos/bbva.svg',
  'Mobile One2One': '/assets/logos/mo2o.svg',
  'Geanet onDemand': '/assets/logos/geanet.svg',
  ComNet: '/assets/logos/comnet-isp.gif',
  Goitek: '/assets/logos/goitek.svg',
};
const iconBySection: Record<string, string> = {
  workflow:
    'M8 7h8M8 12h5M8 17h8M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z',
  architecture:
    'M12 3v5m0 8v5M5 8h14M5 16h14M7 8v8m10-8v8M4 8l8-5 8 5M4 16l8 5 8-5',
  stack:
    'M7 8l-4 4 4 4M17 8l4 4-4 4M14 5l-4 14',
};

const getBrandInitials = (value: string) => brandInitials[value] ?? value.slice(0, 3).toUpperCase();
const isExternalUrl = (href: string) => href.startsWith('http');

const copy = {
  es: {
    navExperience: 'Experiencia',
    navProjects: 'Proyectos',
    navContact: 'Contacto',
    heroPrimary: 'Ver experiencia',
    heroSecondary: 'Ver proyectos',
    currentFocus: 'Foco actual',
    selectedExperience: 'Experiencia reciente',
    selectedProjects: 'Proyectos separados',
    viewAllExperience: 'Ver toda la experiencia',
    viewAllProjects: 'Ver proyectos',
    contactTitle: 'Contacto profesional',
    brandLabel: 'Empresas y clientes destacados',
  },
  en: {
    navExperience: 'Experience',
    navProjects: 'Projects',
    navContact: 'Contact',
    heroPrimary: 'View experience',
    heroSecondary: 'View projects',
    currentFocus: 'Current focus',
    selectedExperience: 'Recent experience',
    selectedProjects: 'Separated projects',
    viewAllExperience: 'View full experience',
    viewAllProjects: 'View projects',
    contactTitle: 'Professional contact',
    brandLabel: 'Selected companies and clients',
  },
}[lang];

const navItems = [
  {
    label: copy.navExperience,
    href: routeSet.experience,
    icon: 'M4 7h16M8 7V5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M5 7h14v12H5V7Zm4 5h6',
  },
  {
    label: copy.navProjects,
    href: routeSet.projects,
    icon: 'M4 6h6l2 2h8v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Zm4 8h8',
  },
  {
    label: copy.navContact,
    href: `#${contactSlug}`,
    icon: 'M4 6h16v12H4V6Zm0 2 8 6 8-6',
  },
];

const contactIcons = {
  email: 'M4 6h16v12H4V6Zm0 2 8 6 8-6',
  github:
    'M12 3a9 9 0 0 0-3 17c.45.08.62-.2.62-.44v-1.55c-2.54.55-3.07-1.08-3.07-1.08-.42-1.05-1.02-1.33-1.02-1.33-.84-.57.06-.56.06-.56.93.07 1.42.96 1.42.96.82 1.4 2.15 1 2.68.76.08-.6.32-1 .58-1.23-2.03-.23-4.16-1.02-4.16-4.52 0-1 .36-1.82.95-2.46-.1-.23-.41-1.16.09-2.42 0 0 .78-.25 2.55.94A8.78 8.78 0 0 1 12 6.76c.79 0 1.58.1 2.32.31 1.77-1.19 2.55-.94 2.55-.94.5 1.26.19 2.19.09 2.42.59.64.95 1.46.95 2.46 0 3.51-2.14 4.28-4.18 4.51.33.28.62.84.62 1.7v2.34c0 .25.17.52.63.44A9 9 0 0 0 12 3Z',
  linkedin: 'M6 9h3v9H6V9Zm1.5-4.2a1.7 1.7 0 1 1 0 3.4 1.7 1.7 0 0 1 0-3.4ZM11 9h3v1.3c.43-.75 1.32-1.55 2.76-1.55 2.42 0 3.24 1.46 3.24 4.1V18h-3v-4.72c0-1.25-.43-1.88-1.42-1.88-.93 0-1.58.63-1.58 1.88V18h-3V9Z',
};

const getContactIcon = (label: string, href: string) => {
  const value = `${label} ${href}`.toLowerCase();

  if (value.includes('github')) return contactIcons.github;
  if (value.includes('linkedin')) return contactIcons.linkedin;

  return contactIcons.email;
};
---

<a class="skip-link" href="#contenido">{labels.skipLink}</a>

<header class="home-header">
  <a class="home-header__brand" href={routeSet.home} aria-label={siteConfig.brand.name}>
    <BrandLogo eager />
  </a>
  <nav class="home-header__nav" aria-label={labels.navLabel}>
    {
      navItems.map((item) => (
        <a href={item.href}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={item.icon} />
          </svg>
          <span>{item.label}</span>
        </a>
      ))
    }
  </nav>
  <div class="home-header__controls">
    <button
      class="home-header__theme"
      type="button"
      aria-label={labels.themeToggleLabel}
      title={labels.themeToggleLabel}
      data-theme-toggle
      data-label-toggle={labels.themeToggleLabel}
      data-label-system={labels.themeSystemLabel}
      data-label-light={labels.themeLightLabel}
      data-label-dark={labels.themeDarkLabel}
    >
      <span data-theme-state>{labels.themeSystemLabel}</span>
    </button>
    <a class="home-header__language" href={alternateLink.href} aria-label={labels.languageLabel}>
      <span aria-current="true">{currentLanguage}</span>
      <span aria-hidden="true">/</span>
      <span>{alternateLanguage}</span>
    </a>
  </div>
</header>

<main id="contenido" class="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__content">
      <p class="home-kicker">{intro.eyebrow}</p>
      <h1 id="home-title">{intro.title}</h1>
      <p class="home-hero__lead">{intro.subtitle}</p>
      <p class="home-hero__body">{intro.content}</p>
      <div class="home-hero__actions" aria-label={copy.currentFocus}>
        <a class="home-button home-button--primary" href={routeSet.experience}>{copy.heroPrimary}</a>
        <a class="home-button" href={routeSet.projects}>{copy.heroSecondary}</a>
      </div>
    </div>
    <aside class="home-hero__summary" aria-label={copy.currentFocus}>
      <p>{copy.currentFocus}</p>
      <ul>
        {intro.items?.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </section>

  <section class="home-brands" aria-labelledby="brands-title">
    <h2 id="brands-title">{copy.brandLabel}</h2>
    <ul>
      {brandMarks.map((brand) => (
        <li>
          <img src={brand.logo} alt={brand.name} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section home-section--split" aria-labelledby="profile-title">
    <div>
      <p class="home-kicker">{profile?.eyebrow}</p>
      <h2 id="profile-title">{profile?.title}</h2>
    </div>
    <div class="home-section__copy">
      <p class="home-section__lead">{profile?.subtitle}</p>
      <p>{profile?.content}</p>
    </div>
  </section>

  <section class="home-section" aria-labelledby="work-title">
    <div class="home-section__heading">
      <p class="home-kicker">{workflow?.eyebrow}</p>
      <h2 id="work-title">{workflow?.title}</h2>
      <p>{workflow?.subtitle}</p>
    </div>
    <div class="home-principles">
      {[workflow, architecture, stack].map(
        (section) =>
          section && (
            <article class="home-principle">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={iconBySection[section.id]} />
              </svg>
              <div>
                <p>{section.eyebrow}</p>
                <h3>{section.title}</h3>
                <span>{section.content}</span>
              </div>
            </article>
          ),
      )}
    </div>
  </section>

  <section class="home-section home-section--timeline" aria-labelledby="experience-title">
    <div class="home-section__heading">
      <p class="home-kicker">{experience.eyebrow}</p>
      <h2 id="experience-title">{copy.selectedExperience}</h2>
      <p>{experience.description}</p>
    </div>
    <ol class="home-timeline">
      {
        featuredExperience.map((item) => (
          <li>
            <span>{item.period}</span>
            <div>
              <h3><span class="home-mark" aria-hidden="true">{getBrandInitials(item.company)}</span>{item.company}</h3>
              {
                experienceLogos[item.company] && (
                  <img class="home-experience-logo" src={experienceLogos[item.company]} alt="" loading="lazy" decoding="async" aria-hidden="true" />
                )
              }
              <p>{item.role}</p>
              <p>{item.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <a class="home-link" href={routeSet.experience}>{copy.viewAllExperience}</a>
  </section>

  <section class="home-section home-section--projects" aria-labelledby="projects-title">
    <div class="home-section__heading">
      <p class="home-kicker">{projects.eyebrow}</p>
      <h2 id="projects-title">{copy.selectedProjects}</h2>
      <p>{projects.description}</p>
    </div>
    <div class="home-projects">
      {
        featuredProjects.map((item) => (
          <article class="home-project">
            <p>{item.context}</p>
            <h3><span class="home-mark" aria-hidden="true">{getBrandInitials(item.context)}</span>{item.name}</h3>
            <span>{item.summary}</span>
          </article>
        ))
      }
    </div>
    <a class="home-link" href={routeSet.projects}>{copy.viewAllProjects}</a>
  </section>

  <section id={contactSlug} class="home-contact" aria-labelledby="contact-title">
    <div>
      <p class="home-kicker">{contact?.eyebrow}</p>
      <h2 id="contact-title">{copy.contactTitle}</h2>
      <p>{contact?.content}</p>
    </div>
    <ul>
      {
        contact?.items?.map((item) => (
          <li>
            {typeof item === 'string' ? (
              item
            ) : (
              <a href={item.href} target={isExternalUrl(item.href) ? '_blank' : undefined} rel={isExternalUrl(item.href) ? 'noreferrer' : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={getContactIcon(item.label, item.href)} />
                </svg>
                <span>{item.label}</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</main>
