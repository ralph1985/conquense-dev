---
import SiteHeader, { type SiteHeaderLabels } from '@/components/SiteHeader.astro';
import type { AlternateLink, Language } from '@/data/i18n';
import ExperienceItem from '@/components/ExperienceItem.astro';
import ProjectItem from '@/components/ProjectItem.astro';
import type { DetailItem } from '@/data/detail-types';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  description: string;
  items: DetailItem[];
  backHref: string;
  backLabel: string;
  lang: Language;
  alternateLink: AlternateLink;
  headerLabels: SiteHeaderLabels;
  stackLabel: string;
  variant: 'experience' | 'projects';
}

const {
  eyebrow,
  title,
  subtitle,
  description,
  items,
  backHref,
  backLabel,
  lang,
  alternateLink,
  headerLabels,
  stackLabel,
  variant,
} = Astro.props;
---

<main id="contenido" class:list={['detail-page', `detail-page--${variant}`]} tabindex="-1">
  <SiteHeader lang={lang} alternateLink={alternateLink} labels={headerLabels} />
  <header class="detail-hero">
    <p class="detail-hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="detail-hero__subtitle">{subtitle}</p>
    <p class="detail-hero__description">{description}</p>
    <a class="detail-hero__back" href={backHref}>← {backLabel}</a>
  </header>

  <section class:list={['detail-list', `detail-list--${variant}`]} aria-label={title}>
    {
      items.map((item) => (
        variant === 'projects' ? (
          <ProjectItem item={item} stackLabel={stackLabel} />
        ) : (
          <ExperienceItem item={item} stackLabel={stackLabel} />
        )
      ))
    }
  </section>
</main>
