---
import { siteConfig } from '@/config/site';

interface DetailItem {
  name?: string;
  company?: string;
  period?: string;
  role: string;
  context?: string;
  summary: string;
  highlights?: string[];
  stack: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  description: string;
  items: DetailItem[];
  backHref: string;
  backLabel: string;
  languageHref: string;
  languageLabel: string;
  languageText: string;
  stackLabel: string;
}

const { eyebrow, title, subtitle, description, items, backHref, backLabel, languageHref, languageLabel, languageText, stackLabel } =
  Astro.props;
---

<main class="detail-page">
  <header class="detail-hero">
    <div class="detail-hero__nav">
      <a class="detail-hero__brand" href={backHref} aria-label={siteConfig.brand.name}>
        <img src={siteConfig.brand.logo} alt={siteConfig.brand.name} width="1200" height="406" />
      </a>
      <a class="detail-hero__back" href={backHref}>{backLabel}</a>
      <a class="detail-hero__language" href={languageHref} aria-label={languageLabel}>{languageText}</a>
    </div>
    <p class="detail-hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="detail-hero__subtitle">{subtitle}</p>
    <p class="detail-hero__description">{description}</p>
  </header>

  <section class="detail-list" aria-label={title}>
    {
      items.map((item) => (
        <article class="detail-item">
          <div class="detail-item__header">
            <p>{item.period ?? item.context}</p>
            <h2>{item.company ?? item.name}</h2>
            <p>{item.role}</p>
          </div>
          <p class="detail-item__summary">{item.summary}</p>
          {item.highlights && (
            <ul class="detail-item__highlights">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
          <ul class="detail-item__stack" aria-label={stackLabel}>
            {item.stack.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>
</main>
