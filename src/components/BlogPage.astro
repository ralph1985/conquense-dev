---
import SiteHeader from '@/components/SiteHeader.astro';
import type { CollectionEntry } from 'astro:content';
import type { AlternateLink, Language } from '@/data/i18n';
import { getBlogArchivePath, getBlogPageCount, getBlogPageEntries } from '@/data/blog';

interface Props {
  lang: Language;
  alternateLink: AlternateLink;
  labels: {
    navLabel: string;
    skipLink: string;
    languageLabel: string;
    navExperience: string;
    navProjects: string;
    navBlog: string;
    navContact: string;
    mobileMenuLabel: string;
    mobileMenuCloseLabel: string;
    themeToggleLabel: string;
    themeSystemLabel: string;
    themeLightLabel: string;
    themeDarkLabel: string;
  };
  entries: CollectionEntry<'blog'>[];
  currentPage?: number;
  totalPages?: number;
}

const { lang, alternateLink, labels, entries, currentPage = 1, totalPages = getBlogPageCount(entries) } = Astro.props;
const copy = lang === 'es'
  ? {
      eyebrow: 'Cuaderno técnico',
      title: 'Lo que leo para construir mejor software.',
      description: 'Comparto las ideas y noticias técnicas que me ayudan a pensar mejor cómo construimos software.',
      source: 'Fuente',
      read: 'min de lectura',
      empty: 'Todavía no hay artículos publicados. Las próximas propuestas aparecerán aquí después de una revisión editorial.',
      archive: 'Archivo permanente',
      pagination: { label: 'Paginación del blog', previous: 'Anterior', next: 'Siguiente', page: 'Página' },
    }
  : {
      eyebrow: 'Technical notebook',
      title: 'What I read to build better software.',
      description: 'I share the technical ideas and news that help me think better about how we build software.',
      source: 'Source',
      read: 'min read',
      empty: 'There are no published articles yet. New proposals will appear here after editorial review.',
      archive: 'Permanent archive',
      pagination: { label: 'Blog pagination', previous: 'Previous', next: 'Next', page: 'Page' },
    };

const pageEntries = getBlogPageEntries(entries, currentPage);
const formatDate = (date: Date) => new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { dateStyle: 'medium' }).format(date);
const pagePath = (page: number) => getBlogArchivePath(lang, page);
---

<main id="contenido" class="blog-page" tabindex="-1">
  <SiteHeader lang={lang} alternateLink={alternateLink} labels={labels} />
  <header class="blog-hero">
    <p class="blog-eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="blog-hero__description">{copy.description}</p>
    <p class="blog-hero__archive">{copy.archive} · {String(entries.length).padStart(2, '0')} {lang === 'es' ? 'artículos' : 'articles'}</p>
  </header>

  <section class="blog-list" aria-labelledby="blog-list-title">
    <h2 id="blog-list-title" class="sr-only">{copy.eyebrow}</h2>
    {
      pageEntries.length > 0 ? pageEntries.map((entry) => (
        <article class="blog-card">
          <div class="blog-card__meta">
            <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time>
            <span>{entry.data.readingTime} {copy.read}</span>
          </div>
          <div class="blog-card__body">
            <div>
              <p class="blog-card__source">{copy.source} / {entry.data.sourceName}</p>
              <h2><a href={`/${lang === 'en' ? 'en/' : ''}blog/${entry.data.slug}/`}>{entry.data.title}</a></h2>
              <p>{entry.data.description}</p>
            </div>
            <ul class="blog-card__tags" aria-label={lang === 'es' ? 'Etiquetas' : 'Tags'}>
              {entry.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      )) : <p class="blog-empty">{copy.empty}</p>
    }
  </section>
  {
    totalPages > 1 && (
      <nav class="blog-pagination" aria-label={copy.pagination.label}>
        {currentPage > 1 ? <a class="blog-pagination__link" href={pagePath(currentPage - 1)} rel="prev">← {copy.pagination.previous}</a> : <span class="blog-pagination__link blog-pagination__link--disabled" aria-disabled="true">← {copy.pagination.previous}</span>}
        <ol aria-label={copy.pagination.label}>
          {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
            <li>
              {page === currentPage ? <span aria-current="page">{page}</span> : <a href={pagePath(page)}>{page}</a>}
            </li>
          ))}
        </ol>
        {currentPage < totalPages ? <a class="blog-pagination__link" href={pagePath(currentPage + 1)} rel="next">{copy.pagination.next} →</a> : <span class="blog-pagination__link blog-pagination__link--disabled" aria-disabled="true">{copy.pagination.next} →</span>}
      </nav>
    )
  }
</main>
