---
import BrandLogo from '@/components/BrandLogo.astro';
import type { PortfolioSection } from '@/data/sections';

interface Props {
  section: PortfolioSection;
  index: number;
  total: number;
  labels: {
    sectionItemsLabel: string;
    sectionActionsLabel: string;
  };
}

const { section, index, total, labels } = Astro.props;
const isExternalUrl = (href: string) => href.startsWith('http');
---

<section
  id={section.slug}
  class={`section-panel section-panel--${section.theme}`}
  style={`--section-accent: ${section.accentColor}`}
  aria-labelledby={`${section.id}-title`}
  data-section-panel
  data-section-index={index}
  data-section-title={section.title}
>
  <div class="section-panel__grid" aria-hidden="true"></div>
  <div class="section-panel__visual" aria-hidden="true">
    <span class="section-panel__orb"></span>
    <span class="section-panel__axis section-panel__axis--x"></span>
    <span class="section-panel__axis section-panel__axis--y"></span>
    <span class="section-panel__plate section-panel__plate--primary"></span>
    <span class="section-panel__plate section-panel__plate--secondary"></span>
  </div>
  <div class="section-panel__content">
    {
      section.id === 'home' && (
        <BrandLogo class="section-panel__brand" eager />
      )
    }
    <p class="section-panel__eyebrow">
      <span>{String(index + 1).padStart(2, '0')}</span>
      <span>{section.eyebrow}</span>
    </p>
    <h1 id={`${section.id}-title`}>{section.title}</h1>
    <p class="section-panel__subtitle">{section.subtitle}</p>
    <p class="section-panel__body">{section.content}</p>
    {
      section.items && (
        <ul class="section-panel__items" aria-label={`${labels.sectionItemsLabel} ${section.title}`}>
          {section.items.map((item) => (
            <li>
              {typeof item === 'string' ? (
                item
              ) : (
                <a href={item.href} target={isExternalUrl(item.href) ? '_blank' : undefined} rel={isExternalUrl(item.href) ? 'noopener noreferrer' : undefined}>
                  {item.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }
    {
      section.actions && (
        <div class="section-panel__actions" aria-label={`${labels.sectionActionsLabel} ${section.title}`}>
          {section.actions.map((action) => (
            <a href={action.href}>{action.label}</a>
          ))}
        </div>
      )
    }
  </div>
  <p class="section-panel__position" aria-hidden="true">
    {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
  </p>
</section>
