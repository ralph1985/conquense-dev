---
interface Props {
  initials: string;
  logo?: string;
  technology?: boolean;
  wide?: boolean;
}

const { initials, logo, technology = false, wide = false } = Astro.props;
---

<span class:list={['company-logo', { 'company-logo--technology': technology, 'company-logo--wide': wide }]} aria-hidden="true">
  {logo ? <img src={logo} alt="" loading="lazy" decoding="async" /> : initials}
</span>
