---
import DetailPage from '@/components/DetailPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedExperience } from '@/data/experience';
import { routesByLanguage, uiCopy } from '@/data/i18n';

const page = localizedExperience.en;
---

<BaseLayout
  lang="en"
  title="Experience - Rafael Garcia Prieto"
  description="Professional experience of Rafael Garcia Prieto in frontend, mobile web, JavaScript and management applications."
  alternateLinks={[{ lang: 'es', href: routesByLanguage.es.experience }, { lang: 'en', href: routesByLanguage.en.experience }]}
>
  <DetailPage
    eyebrow={page.eyebrow}
    title={page.title}
    subtitle={page.subtitle}
    description={page.description}
    items={page.items}
    lang="en"
    alternateLink={{ lang: 'es', href: routesByLanguage.es.experience }}
    headerLabels={uiCopy.en}
    stackLabel={uiCopy.en.stackLabel}
  />
</BaseLayout>
