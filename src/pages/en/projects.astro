---
import DetailPage from '@/components/DetailPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routesByLanguage, uiCopy } from '@/data/i18n';
import { localizedProjects } from '@/data/projects';
import { localizedPortfolioSections } from '@/data/sections';

const page = localizedProjects.en;
---

<BaseLayout
  lang="en"
  title="Projects - Rafael Garcia Prieto"
  description="Selected projects and professional contexts of Rafael Garcia Prieto as a Senior Frontend Engineer."
  alternateLinks={[{ lang: 'es', href: routesByLanguage.es.projects }, { lang: 'en', href: routesByLanguage.en.projects }]}
>
  <DetailPage
    eyebrow={page.eyebrow}
    title={page.title}
    subtitle={page.subtitle}
    description={page.description}
    items={page.items}
    backHref={`${routesByLanguage.en.home}#${localizedPortfolioSections.en.find((section) => section.id === 'projects')?.slug ?? 'projects'}`}
    backLabel={uiCopy.en.backToJourney}
    languageHref={routesByLanguage.es.projects}
    languageLabel={uiCopy.en.languageLabel}
    languageText="ES"
    stackLabel={uiCopy.en.stackLabel}
    themeToggleLabel={uiCopy.en.themeToggleLabel}
    themeSystemLabel={uiCopy.en.themeSystemLabel}
    themeLightLabel={uiCopy.en.themeLightLabel}
    themeDarkLabel={uiCopy.en.themeDarkLabel}
  />
</BaseLayout>
