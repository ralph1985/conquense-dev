---
import DetailPage from '@/components/DetailPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routesByLanguage, uiCopy } from '@/data/i18n';
import { localizedProjects } from '@/data/projects';

const page = localizedProjects.en;
---

<BaseLayout
  lang="en"
  title="Projects - Rafael Garcia Prieto"
  description="Selected projects and professional contexts of Rafael Garcia Prieto as a Senior Frontend Engineer."
  alternateLinks={[{ lang: 'es', href: routesByLanguage.es.projects }, { lang: 'en', href: routesByLanguage.en.projects }]}
>
  <DetailPage
    eyebrow={page.eyebrow}
    title={page.title}
    subtitle={page.subtitle}
    description={page.description}
    items={page.items}
    lang="en"
    alternateLink={{ lang: 'es', href: routesByLanguage.es.projects }}
    headerLabels={uiCopy.en}
    stackLabel={uiCopy.en.stackLabel}
  />
</BaseLayout>
