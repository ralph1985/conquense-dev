---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomePage from '@/components/HomePage.astro';
import { routesByLanguage, uiCopy } from '@/data/i18n';
---

<BaseLayout lang="es" alternateLinks={[{ lang: 'es', href: routesByLanguage.es.home }, { lang: 'en', href: routesByLanguage.en.home }]}>
  <HomePage lang="es" alternateLink={{ lang: 'en', href: routesByLanguage.en.home }} labels={uiCopy.es} />
</BaseLayout>
