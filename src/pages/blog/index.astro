---
import { getCollection } from 'astro:content';
import BlogPage from '@/components/BlogPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routesByLanguage, uiCopy } from '@/data/i18n';

const entries = (await getCollection('blog')).filter((entry) => entry.data.lang === 'es');
---

<BaseLayout
  lang="es"
  title="Blog técnico - Conquense Dev"
  description="Noticias y contexto sobre ingeniería de software, arquitectura, IA aplicada, seguridad y rendimiento web."
  alternateLinks={[{ lang: 'es', href: routesByLanguage.es.blog }, { lang: 'en', href: routesByLanguage.en.blog }]}
>
  <BlogPage lang="es" alternateLink={{ lang: 'en', href: routesByLanguage.en.blog }} labels={uiCopy.es} entries={entries} />
</BaseLayout>
