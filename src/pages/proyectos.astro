---
import DetailPage from '@/components/DetailPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { routesByLanguage, uiCopy } from '@/data/i18n';
import { localizedProjects } from '@/data/projects';
import { localizedPortfolioSections } from '@/data/sections';

const page = localizedProjects.es;
---

<BaseLayout
  lang="es"
  title="Proyectos - Rafael García Prieto"
  description="Selección de proyectos y contextos profesionales de Rafael García Prieto como Frontend Senior."
  alternateLinks={[{ lang: 'es', href: routesByLanguage.es.projects }, { lang: 'en', href: routesByLanguage.en.projects }]}
>
  <DetailPage
    eyebrow={page.eyebrow}
    title={page.title}
    subtitle={page.subtitle}
    description={page.description}
    items={page.items}
    backHref={`/#${localizedPortfolioSections.es.find((section) => section.id === 'projects')?.slug ?? 'proyectos'}`}
    backLabel={uiCopy.es.backToJourney}
    languageHref={routesByLanguage.en.projects}
    languageLabel={uiCopy.es.languageLabel}
    languageText="EN"
    stackLabel={uiCopy.es.stackLabel}
  />
</BaseLayout>
