---
import DetailPage from '@/components/DetailPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedExperience } from '@/data/experience';
import { routesByLanguage, uiCopy } from '@/data/i18n';
import { localizedPortfolioSections } from '@/data/sections';

const page = localizedExperience.es;
---

<BaseLayout
  lang="es"
  title="Experiencia - Rafael García Prieto"
  description="Experiencia profesional de Rafael García Prieto en frontend, mobile web, JavaScript y aplicaciones de gestión."
  alternateLinks={[{ lang: 'es', href: routesByLanguage.es.experience }, { lang: 'en', href: routesByLanguage.en.experience }]}
>
  <DetailPage
    eyebrow={page.eyebrow}
    title={page.title}
    subtitle={page.subtitle}
    description={page.description}
    items={page.items}
    backHref={`/#${localizedPortfolioSections.es.find((section) => section.id === 'experience')?.slug ?? 'experiencia'}`}
    backLabel={uiCopy.es.backToJourney}
    lang="es"
    alternateLink={{ lang: 'en', href: routesByLanguage.en.experience }}
    headerLabels={uiCopy.es}
    stackLabel={uiCopy.es.stackLabel}
  />
</BaseLayout>
