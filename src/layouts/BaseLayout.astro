---
import { siteConfig } from '@/config/site';
import type { AlternateLink, Language } from '@/data/i18n';
import '@/styles/tailwind.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Language;
  alternateLinks?: AlternateLink[];
}

const lang = Astro.props.lang ?? 'es';
const title = Astro.props.title ?? siteConfig.title[lang];
const description = Astro.props.description ?? siteConfig.description[lang];
const canonical = new URL(Astro.url.pathname, siteConfig.canonical).toString();
const ogImage = new URL(siteConfig.ogImage, siteConfig.canonical).toString();
const alternateLinks = Astro.props.alternateLinks ?? [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={siteConfig.brand.icon} />
    <link rel="apple-touch-icon" href={siteConfig.brand.icon} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.lang} href={new URL(link.href, siteConfig.canonical).toString()} />)}
    {alternateLinks.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternateLinks[0]?.href ?? '/', siteConfig.canonical).toString()} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.brand.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteConfig.brand.name} />
    <script is:inline>
      (() => {
        const storageKey = 'conquense-dev-theme';
        const darkQuery = '(prefers-color-scheme: dark)';
        let storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const resolvedTheme =
          storedTheme === 'light' || storedTheme === 'dark'
            ? storedTheme
            : window.matchMedia(darkQuery).matches
              ? 'dark'
              : 'light';

        document.documentElement.dataset.theme = resolvedTheme;
        document.documentElement.dataset.themePreference = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'system';
        document.documentElement.style.colorScheme = resolvedTheme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import { initThemeControls } from '@/scripts/theme';

  initThemeControls();
</script>
